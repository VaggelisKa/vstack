{
  "skill_name": "html-plan",
  "evals": [
    {
      "id": 1,
      "prompt": "/vstack:html-plan add a per-request timeout option to the API client, with a test",
      "expected_output": "Writes one HTML plan (a tree of claims: what, how, where with file:line) for the timeout option, packs and lints it with pack.mjs, gives the user the packed file, and does not start building.",
      "files": [],
      "expectations": [
        "Reads references/blocks.md or the example before writing the page",
        "Writes one HTML file and runs pack.mjs on it, fixing any errors it reports",
        "The plan's where-level claims point at real places such as src/client.js and test/client.test.js",
        "Puts the decisions the user must make (such as the default timeout) on the claims they change",
        "Does not change src/ or test/, and ends by asking for the user's response before building"
      ],
      "eval": {
        "slug": "slash-plan",
        "tags": [
          "smoke"
        ],
        "fixture": "pr-green",
        "graders": [
          {
            "name": "packs",
            "trace": "pack\\.mjs",
            "covers": [
              1
            ]
          },
          {
            "name": "no-source-edits",
            "tool": "Edit",
            "input": "src/|test/",
            "max": 0,
            "covers": [
              4
            ]
          },
          {
            "name": "no-source-writes",
            "tool": "Write",
            "input": "\\\"file_path\\\":\\s*\\\"[^\\\"]*/(src|test)/",
            "max": 0,
            "covers": [
              4
            ]
          },
          {
            "name": "packed",
            "trace": "pack\\.mjs[^\\n]{0,400}\\.html",
            "covers": [
              1
            ]
          }
        ]
      }
    },
    {
